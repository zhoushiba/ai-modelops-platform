# ============================================================================
# 前端本地环境变量示例（复制为 frontend/.env.local 后按需修改）
# 说明：这些变量在 `npm run build` 时被注入，仅用于本地演示/截图；
#      正常使用请在登录页手工输入账号，不要开启自动登录。
# ============================================================================

# 开发服务器 / 预览服务器把 /api 与 /v1 代理到后端，无需配置 baseURL

# 打开页面即用演示账号自动登录（1 = 开启，0 = 关闭）
VITE_DEMO_AUTO_LOGIN=0
# 演示账号（默认与后端 seed 一致）
VITE_DEMO_USERNAME=admin
VITE_DEMO_PASSWORD=admin123
# 推理调试台预填的 API Key（可留空，运行时也可手填）
VITE_DEMO_API_KEY=
