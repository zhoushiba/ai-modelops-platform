# ============================================================================
# AI ModelOps Platform · 环境变量示例
# 用法：cp .env.example .env（docker compose 会读取根目录 .env）
#      本地直接跑后端时，也可以复制为 backend/.env（pydantic-settings 会读取）
# 说明：所有变量均有默认值，只有生产/Compose 场景才需要覆盖。
# ============================================================================

# ---- 应用 ----
APP_NAME=AI ModelOps Platform
APP_VERSION=1.0.0
ENV=dev
API_PREFIX=/api
LOG_LEVEL=INFO

# ---- 数据库 ----
# 本地默认 SQLite（无需额外服务）；生产可切换 MySQL 8 / PostgreSQL 16
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=mysql+pymysql://modelops:modelops123@127.0.0.1:3306/modelops?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg://modelops:modelops123@127.0.0.1:5432/modelops
DB_ECHO=false

# ---- 存储 ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# ---- 认证 ----
# 生产务必替换 JWT_SECRET（建议 `python -c "import secrets;print(secrets.token_urlsafe(48))"`）
JWT_SECRET=please-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 训练 worker ----
TRAINING_INLINE=false
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=0.2
SEED_SAMPLES=true

# ---- 限流与配额（API Key 默认值） ----
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=10
TOKEN_QUOTA=200000

# ---- 上游 LLM（可选；留空则由本地推理运行时回答） ----
UPSTREAM_LLM_BASE_URL=
UPSTREAM_LLM_API_KEY=
UPSTREAM_LLM_MODEL=gpt-4o-mini
UPSTREAM_TIMEOUT_SECONDS=30

# ---- CORS（逗号分隔） ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ============================================================================
# Docker Compose 专用变量
# ============================================================================
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=modelops
MYSQL_USER=modelops
MYSQL_PASSWORD=modelops123
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ============================================================================
# 前端构建期变量（VITE_ 前缀，写在前端环境里；仅供本地演示/截图使用）
# ============================================================================
# 自动登录演示账号（默认关闭；打开后打开页面即进入看板）
VITE_DEMO_AUTO_LOGIN=0
# 推理调试台预填的 API Key（可留空）
VITE_DEMO_API_KEY=
